@startuml
skinparam defaultFontName "DejaVu Sans"
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontColor #25364F
skinparam ArrowColor #25364F
skinparam ArrowFontColor #25364F
skinparam ArrowFontSize 11
skinparam ActorBorderColor #25364F
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorFontColor #25364F
skinparam UsecaseBorderColor #25364F
skinparam UsecaseBackgroundColor #F3F5F8
skinparam UsecaseFontColor #25364F
skinparam RectangleBorderColor #25364F
skinparam RectangleBackgroundColor #FFFFFF
skinparam RectangleFontColor #AF2A35
skinparam RectangleFontStyle bold
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #8A94A6
skinparam NoteFontColor #25364F
skinparam TitleFontColor #25364F
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
left to right direction
title Вход и смена начального пароля

actor "Сотрудник" as Emp
actor "Администратор" as Adm

rectangle "AI-помощник менеджера по заявкам" {
  usecase "Создать пользователя\nс начальным паролем" as UC1
  usecase "Войти по логину\nи паролю" as UC2
  usecase "Проверить пароль\nи выдать сессию" as UC3
  usecase "Сменить начальный\nпароль" as UC4
  usecase "Проверить надёжность\nнового пароля" as UC5
  usecase "Выйти из системы" as UC6
  usecase "Записать действие\nв журнал" as UC7
}

Adm --> UC1
Emp --> UC2
Emp --> UC4
Emp --> UC6
UC2 .> UC3 : <<include>>
UC4 .> UC5 : <<include>>
UC4 .> UC2 : <<extend>>
UC1 .> UC7 : <<include>>

note right of UC4
  Обязательна при первом входе:
  до смены пароля работа
  с письмами недоступна
end note
@enduml
