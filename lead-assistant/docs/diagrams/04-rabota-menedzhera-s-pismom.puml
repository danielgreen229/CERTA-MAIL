@startuml
skinparam defaultFontName "DejaVu Sans"
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontColor #25364F
skinparam ArrowColor #25364F
skinparam ArrowFontColor #25364F
skinparam ArrowFontSize 11
skinparam ActorBorderColor #25364F
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorFontColor #25364F
skinparam UsecaseBorderColor #25364F
skinparam UsecaseBackgroundColor #F3F5F8
skinparam UsecaseFontColor #25364F
skinparam RectangleBorderColor #25364F
skinparam RectangleBackgroundColor #FFFFFF
skinparam RectangleFontColor #AF2A35
skinparam RectangleFontStyle bold
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #8A94A6
skinparam NoteFontColor #25364F
skinparam TitleFontColor #25364F
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
left to right direction
title Работа менеджера с письмом

actor "Менеджер" as Mgr

rectangle "AI-помощник менеджера по заявкам" {
  usecase "Открыть письмо" as UC1
  usecase "Просмотреть разбор\nи черновик ответа" as UC2
  usecase "Принять черновик" as UC3
  usecase "Исправить черновик" as UC4
  usecase "Отклонить черновик\nс причиной" as UC5
  usecase "Назначить ответственного\n(сотрудник или отдел)" as UC6
  usecase "Просмотреть историю\nписьма" as UC7
  usecase "Записать решение\nв историю" as UC8
}

Mgr --> UC1
Mgr --> UC3
Mgr --> UC4
Mgr --> UC5
Mgr --> UC6
Mgr --> UC7
UC1 .> UC2 : <<include>>
UC3 .> UC8 : <<include>>
UC4 .> UC8 : <<include>>
UC5 .> UC8 : <<include>>
UC6 .> UC8 : <<include>>
@enduml
