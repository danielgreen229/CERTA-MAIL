# Скопируйте в .env и заполните. .env в репозиторий не попадает.

# Адрес веб-интерфейса (по умолчанию 127.0.0.1:8000).
# LEADS_PUBLISH=127.0.0.1:8000

# Подключения по умолчанию: LEADS_<ИМЯ>_<ПОЛЕ>. Применяются при первом запуске, если подключение
# ещё не настроено; сразу проверяются и принадлежат администратору. Остальные ящики и боты
# сотрудники добавляют сами в «Почта и сервисы».
# LEADS_EMAIL_HOST=imap.mail.ru
# LEADS_EMAIL_PORT=993
# LEADS_EMAIL_USER=leads@example.ru
# LEADS_EMAIL_PASSWORD=пароль-для-внешнего-приложения
# LEADS_EMAIL_FOLDER=INBOX
# Telegram-бот администратора (токен от @BotFather; адрес Bot API не нужен):
# LEADS_TELEGRAM_BOT_TOKEN=123456:ABC...
# LEADS_TMS_BASE_URL=https://tms.example.ru
# LEADS_TMS_API_KEY=...
# LEADS_TMS_STATUS_PATH=/shipments/{number}
